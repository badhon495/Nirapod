# Copy to .env and fill in values before running docker-compose
# All vars marked REQUIRED must be set; others have safe defaults for local dev.

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED — generate: openssl rand -base64 32
JWT_SECRET=

# REQUIRED — generate: openssl rand -base64 32
AUTH_SECRET=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Use an App Password (not account password): https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Database (optional overrides — Docker Compose provides defaults) ─────────
DATABASE_URL=jdbc:postgresql://postgres:5432/nirapod
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ─── Redis (optional override) ────────────────────────────────────────────────
# Upstash prod format: rediss://:PASSWORD@HOST:PORT
REDIS_URL=redis://redis:6379

# ─── HikariCP ─────────────────────────────────────────────────────────────────
# Set to 5 on Supabase/Neon free tier; raise to 20 if self-hosting Postgres
HIKARI_MAX_POOL_SIZE=5

# ─── Admin ────────────────────────────────────────────────────────────────────
# Email that receives weekly stats reports
ADMIN_EMAIL=

# ─── Sentry (optional — leave blank to disable error tracking) ────────────────
# Backend: https://sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN_BACKEND=
# Frontend:
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─── Spring profile ───────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
