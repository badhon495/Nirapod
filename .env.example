# Copy to .env and fill in values before running docker-compose

# JWT — generate: openssl rand -base64 32
JWT_SECRET=

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Gmail SMTP — use App Password, not account password)
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
